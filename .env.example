# Copia este archivo a ".env" y ajusta los valores.
# El .env real NO se sube a Git (está en .gitignore): contiene secretos.

# --- Base de datos ---
DB_USER=gym
DB_PASSWORD=gym
DB_NAME=gymcontrol
DB_PORT=5432

# --- Backend (se usará en el siguiente paso) ---
# Secreto para firmar los JWT. En producción: una cadena larga y aleatoria.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
API_PORT=8080
